{
  "name": "nmas-auth-service",
  "version": "0.0.1",
  "description": "Auth service",
  "author": "Umair khan",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "pm2:start": "sh scripts/start_server.sh",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs}/**/*.ts\"",
    "docker:build": "sudo  docker build . -t main",
    "prepare": "husky",
    "pre-commit": "tsc --noEmit --pretty && npm run lint && npm run prettier:check && npm run build",
    "prettier:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,cjs}\" -c ./.prettierrc",
    "prettier:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,cjs}\" -c ./.prettierrc",
    "generate": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_opt=nestJs=true,env=node,returnObservable=false,addGrpcMetadata=true --ts_proto_out=. src/proto/*.proto --experimental_allow_proto3_optional"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "@google-cloud/storage": "7.16.0",
    "@grpc/grpc-js": "^1.13.2",
    "@grpc/proto-loader": "^0.7.13",
    "@keyv/redis": "^4.3.3",
    "@nestjs/apollo": "^13.0.4",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.13",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.13",
    "@nestjs/graphql": "^13.0.4",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/microservices": "^11.0.13",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.13",
    "@nestjs/swagger": "^11.1.1",
    "@nestjs/websockets": "^11.0.13",
    "@newrelic/winston-enricher": "^4.0.1",
    "@types/newrelic": "^9.14.8",
    "bcryptjs": "^3.0.2",
    "cache-manager": "^6.4.2",
    "cache-manager-ioredis-yet": "^2.1.2",
    "cacheable": "^1.8.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "google-auth-library": "9.6.3",
    "graphql": "^16.10.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "kafkajs": "^2.2.4",
    "keyv": "5.3.3",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48",
    "mongoose": "^8.13.2",
    "nanoid": "^5.1.5",
    "nestjs-cls": "^5.4.2",
    "nestjs-i18n": "^10.5.1",
    "passport": "^0.7.0",
    "passport-http": "^0.3.0",
    "passport-jwt": "^4.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "speakeasy": "^2.0.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "lint-staged": {
    "*.{ts,js,css,md}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.4",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.1",
    "@types/nanoid": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/passport-http": "^0.3.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.7.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
